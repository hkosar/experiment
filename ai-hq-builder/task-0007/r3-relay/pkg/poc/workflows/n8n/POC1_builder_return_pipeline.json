      },
      "id": "record-non-relay-outcome",
      "name": "Record Non-Relay Outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        880,
        420
      ],
      "notes": "FAIL-CLOSED. Duplicate suppression, unauthorized target and refusals are all recorded — never silently dropped.",
      "notesInFlow": false
    },
    {
      "parameters": {
