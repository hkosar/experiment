              "value": "={{ $env.AIOS_PROVIDER_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "record-unauthorized",
      "name": "Record Unauthorized",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1540,
