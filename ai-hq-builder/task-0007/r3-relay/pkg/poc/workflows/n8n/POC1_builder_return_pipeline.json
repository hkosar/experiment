      },
      "id": "controlled-relay",
      "name": "Controlled Relay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1540,
        120
      ],
      "notes": "EXECUTION. The endpoint comes from the ActionRequest the AI OS built by resolving the ROLE — never from this workflow. The capability is bound to the action id, case, target and payload digest; a replay returns the prior receipt with no second side effect (R1P-04 test 4).",
      "notesInFlow": false
    },
    {
