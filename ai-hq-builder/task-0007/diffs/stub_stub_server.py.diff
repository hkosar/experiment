+        except BaseException as exc:                              # noqa: BLE001
+            recovered = [{"route": "startup", "step": "quarantine-marker-scan",
+                          "problems": ["quarantine marker scan failed (%s: %s)"
+                                       % (type(exc).__name__, exc)]}]
+        STORE.storage_quarantine.extend(recovered)
