+        "jsCode": "// 25_ A.1 — the identity tuple, all five components. A raw archive hash alone\n// is NOT identity: two tasks may legitimately submit byte-identical artifacts,\n// and one task may resubmit with changed routing.\n//\n// 25_ A.2 — `registration_ref` is minted by the OWNER at\n// /owner/artifact/register and travels with the submission. This workflow\n// carries it; it cannot mint one, and a submission without one is refused here\n// rather than sent on, because the wrapper would refuse it anyway and a local\n// refusal is the one that records why.\nconst crypto = require('crypto');\nreturn items.map(i => {\n  const b64 = i.json.artifact_b64 || '';\n  const digest = crypto.createHash('sha256')\n                       .update(Buffer.from(b64, 'base64')).digest('hex');\n  if (!i.json.registration_ref) {\n    throw new Error('no registration_ref: the owner must register the artifact '\n      + 'at /owner/artifact/register before it can be submitted. The digest '\n      + 'computed here is only ever CHECKED AGAINST the owner-registered '\n      + 'source_digest — it is never an authority on its own (25_ A.2).');\n  }\n  return { json: {\n    envelope: { trust: 'external-untrusted', partition: 'business' },\n    registration_ref: i.json.registration_ref,   // owner-minted (A.2)\n    // the five identity components (A.1)\n    task_id: i.json.task_id,\n    transition: i.json.transition,          // e.g. 'builder->verifier'\n    artifact_digest: digest,                // computed here, not trusted\n    target_role: i.json.target_role,        // SYMBOLIC role; the wrapper resolves it\n    submission_epoch: Number(i.json.submission_epoch ?? 0)\n  } };\n});"
